# Copy to .env and adjust, then: docker compose up -d

# --- Watcher ---
# tiny | base | small | medium | large-v3 | large-v3-turbo | /app/models/<dir>
MODEL=large-v3-turbo
# baseline,perturn | perturn | baseline
MODES=baseline,perturn
# srt | vtt | text
FORMAT=srt
DEVICE=cpu
COMPUTE_TYPE=int8
# 0 = all cores
CPU_THREADS=0

# --- Per-turn tuning ---
STT_WHISPER2_PER_TURN_MIN_SILENCE_MS=1000
STT_WHISPER2_PER_TURN_MIN_DETECT_S=3
STT_WHISPER2_PER_TURN_MIN_PROB=0.6

# --- ExApp profile only ---
NEXTCLOUD_URL=http://nextcloud.local/index.php
APP_SECRET=12345
STT_WHISPER2_PER_TURN_LANGUAGE=1
